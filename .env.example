# ─────────────────────────────────────────────────────────────────────────────
# OCR / Home Visit Form Extraction — environment configuration
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
# `.env` is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider (Gemini) ───────────────────────────────────────────────────
# Required. Used when PRIMARY_API_KEY is not set.
GEMINI_API_KEY=

# Optional override: model, api key and base URL per role.
# Roles used by the pipeline: PRIMARY (extraction) and SECONDARY (verification).
PRIMARY_MODEL=gemini-3.5-flash-lite
PRIMARY_API_KEY=
PRIMARY_BASE_URL=https://generativelanguage.googleapis.com

SECONDARY_MODEL=gemini-3.1-flash-lite
SECONDARY_API_KEY=
SECONDARY_BASE_URL=https://generativelanguage.googleapis.com

GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_API_TIMEOUT=180

# Gemini quota: 14 requests / 250k tokens per minute on the free tier.
# GEMINI_RATE_LIMIT_TPM is enforced with a sliding 60s window using the actual
# token usage reported by the API (not an estimate).
GEMINI_RATE_LIMIT_TPM=250000
# Global cooldown (seconds) applied to ALL requests when the API returns a
# 429 quota-exhausted error, to avoid a thundering herd of retries.
GEMINI_429_BACKOFF_SEC=30

# ── Zoho Creator / Supabase (required at startup) ───────────────────────────
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional webhook auth. Leave empty to disable auth on the webhook endpoint.
WEBHOOK_SECRET=

# ── Database ────────────────────────────────────────────────────────────────
# Optional: if unset, DB persistence is skipped.
DATABASE_URL=
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=20
DATABASE_CONNECT_TIMEOUT=10

# ── Concurrency & Rate Limits ───────────────────────────────────────────────
# Defaults are tuned for a RAM-bound dev box (one uvicorn worker serves both
# the UI and all processing). Raise these on a beefier machine.
GLOBAL_LLM_MAX_CONCURRENCY=3
GEMINI_MAX_CONCURRENCY=2
GEMINI_RATE_LIMIT_RPM=14
LLM_MAX_RETRIES=5
MAX_CONCURRENT_JOBS=2
RENDER_MAX_CONCURRENCY=3
BATCH_MAX_CONCURRENCY=2
BATCH_HIGH_THROUGHPUT=false
BATCH_HIGH_THROUGHPUT_WORKERS=8

# Circuit breaker (per-client) on repeated LLM failures
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# Adaptive concurrency limiter
ADAPTIVE_CONCURRENCY_ENABLED=false
ADAPTIVE_CONCURRENCY_INITIAL=6
ADAPTIVE_CONCURRENCY_MIN=2
ADAPTIVE_CONCURRENCY_MAX=12
ADAPTIVE_CONCURRENCY_TARGET_LATENCY=1.0

# ── Rendering & Extraction ──────────────────────────────────────────────────
RENDER_DPI=150
MAX_IMAGE_WIDTH=1600
LLM_USE_COLOR_IMAGE=true
PAGE_GROUP_SIZE=2
COMBINE_PAGES=false
REFINEMENT_MIN_CONFIDENCE=50

# ── Server / UI ─────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
METRICS_LOG_INTERVAL_SEC=300
CLEANUP_INTERVAL_SEC=600
JOB_MAX_AGE_SEC=604800
MAX_FOLDER_ITEMS=200

# ── Zoho Startup Poll / Local Batch ─────────────────────────────────────────
# The poller auto-processes pending Zoho records on startup + every interval.
# Disable with ZOHO_POLL_ENABLED=false, or keep it delayed so a fresh boot
# isn't slammed while the UI is opening.
ZOHO_POLL_ENABLED=true
ZOHO_POLL_STARTUP_DELAY_SEC=60
# ZOHO_POLL_INTERVAL_SEC=1800
# ZOHO_POLL_APP_OWNER=teameverest
# ZOHO_POLL_APP_LINK_NAME=iatc-selection-one-app
# ZOHO_POLL_REPORT_LINK_NAME=Volunteer_Home_Visited_Form_Report
# ZOHO_POLL_FILE_FIELD_LINK_NAME=Upload_Home_Visit_Form
# ZOHO_POLL_MAX_CONCURRENT=2
# ZOHO_POLL_CRITERIA=

# Local CSV batch processing
ZOHO_CSV_PATH=tests/fixtures/sample.csv
ZOHO_LOCAL_INPUT_DIR=Test_Batch/1test

# Set to true to skip writing fields back to Zoho Creator (dry-run the pipeline)
SKIP_ZOHO_CREATOR=true
